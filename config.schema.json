    "advanced": {
      "type": "object",
      "title": "Advanced",
      "description": "Settings that apply to every ECU.",
      "properties": {
        "prefix": {
          "type": "string",
          "title": "Prefix",
          "description": "Leading trace source every ECU publishes under, so events read '<prefix>/<ecu>/<event>'. Clear it to give each ECU its own trace source with events '<event>'.",
          "default": "XCP",
          "ui:placeholder": "XCP",
          "ui:emptyValue": ""
        },
        "log_level": {
          "type": "string",
          "title": "Log Level",
          "description": "Extension logging verbosity",
          "enum": [
            "DEBUG",
            "INFO",
            "WARNING",
            "ERROR"
          ],
          "default": "INFO"
        },
        "timestamp_mode": {
          "type": "string",
          "title": "Timestamp Mode",
          "description": "Which clock places samples in the trace: 'auto' uses the ECU's timestamp when it sends one, anchored to local time once at measurement start, otherwise the local receive time; 'host' always uses the local receive time.",
          "enum": [
            "auto",
            "host"
          ],
          "default": "auto"
        },
        "epk_check": {
          "type": "string",
          "title": "EPK Check",
          "description": "Compare the A2L's EPK (firmware build id) with the ECU's at connect. 'strict' refuses to measure on a mismatch, since a stale A2L reads plausible but wrong values; 'warn' logs the mismatch and measures anyway.",
          "enum": [
            "strict",
            "warn"
          ],
          "default": "strict"
        },
        "timeout": {
          "type": "number",
          "title": "Timeout (seconds)",
          "description": "How long to wait for the ECU to answer a command before retrying",
          "default": 1.0,
          "minimum": 0.1,
          "maximum": 30.0
        },
        "retries": {
          "type": "integer",
          "title": "Retries",
          "description": "Extra attempts per command before it counts as failed. Each failed command costs timeout x (1 + retries).",
          "default": 1,
          "minimum": 0,
          "maximum": 5
        },
        "max_bus_load": {
          "type": "number",
          "title": "Max Bus Load (%)",
          "description": "XCP on CAN: measurement is refused when the DAQ traffic of the selection is estimated above this share of the bus bitrate; leave empty for no limit. The estimate counts the XCP frames only, not the bus's other traffic, and is always reported.",
          "minimum": 1,
          "maximum": 100
        },
        "debug_frames": {
          "type": "boolean",
          "title": "Debug Frames",
          "description": "Log every XCP command, response and event packet (direction, PID, bytes) at DEBUG level, and DAQ packets per second, never their data. Set Log Level to DEBUG to see them.",
          "default": false,
          "ui:widget": "toggle"
        }
      },
      "additionalProperties": false,
      "default": {},
      "ui:options": {
        "collapsed": true
      }
    }
  },
  "required": [
    "ecus"
  ]
}
