{
  "$comment": "XCP extension configuration schema. See https://docs.zeloscloud.io/sdk/how-to/develop-extensions/#configuration",
  "type": "object",
  "title": "XCP Configuration",
  "description": "Measure one or more ECUs over XCP, with signals named and scaled by each ECU's A2L file.",
  "ui:options": {
    "autoconfig": "XCP/auto_config"
  },
  "properties": {
    "ecus": {
      "type": "array",
      "title": "ECUs",
      "description": "Add an ECU for each XCP slave to measure. Auto-configure adds a demo ECU, or fills an ECU that has an A2L file and no measurements.",
      "items": {
        "title": "ECU",
        "type": "object",
        "properties": {
          "interface": {
            "type": "string",
            "title": "Interface",
            "description": "How the extension reaches the ECU. XCP on CAN: SocketCAN (Linux, zelos-can's SocketCAN bus), SocketCAN over SSH (a remote Linux device's SocketCAN over SSH, from any OS), PCAN, Kvaser, Vector, slcan, or Other (any python-can interface). XCP on UDP or TCP, as the ECU provides. Demo: a built-in simulated ECU with no hardware. A wrong choice looks the same as no ECU. The extension connects when it starts, and an ECU serves one XCP tool at a time: connecting can end another XCP tool's session without an error on either side.",
            "enum": [
              "SocketCAN",
              "SocketCAN over SSH",
              "PCAN",
              "Kvaser",
              "Vector",
              "slcan (serial)",
              "Other (python-can)",
              "XCP on UDP",
              "XCP on TCP",
              "Demo"
            ]
          },
          "name": {
            "type": "string",
            "title": "Display Name",
            "description": "Name in the trace, e.g. inverter gives XCP/inverter/... Optional.",
            "ui:placeholder": "inverter"
          },
          "a2l_file": {
            "type": "string",
            "title": "A2L File",
            "description": "The ECU's A2L, e.g. ~/a2l/inverter.a2l. Must match the ECU's firmware.",
            "ui:widget": "file-picker",
            "ui:options": {
              "accept": ".a2l"
            },
            "ui:placeholder": "~/a2l/inverter.a2l"
          },
          "measurements": {
            "type": "array",
            "title": "Measurements",
            "description": "What to record. Usually one group: Event Default plus your signal names.",
            "default": [],
            "items": {
              "title": "Measurement Group",
              "type": "object",
              "properties": {
                "event": {
                  "type": "string",
                  "title": "Event",
                  "description": "When the ECU samples these signals. Leave Default unless you need one fixed event or polling.",
                  "enum": [
                    "default",
                    "poll",
                    "a2l"
                  ],
                  "enumNames": [
                    "Default (from the A2L)",
                    "Poll",
                    "One A2L event"
                  ],
                  "default": "default"
                },
                "signals": {
                  "type": "array",
                  "title": "Signals",
                  "description": "A2L measurement names, e.g. nEngine, tCoolant.",
                  "default": [],
                  "items": {
                    "type": "string",
                    "ui:widget": "action-choices",
                    "ui:options": {
                      "action": "XCP/list_a2l_measurements"
                    }
                  }
                }
              },
              "required": [
                "event"
              ],
              "dependencies": {
                "event": {
                  "oneOf": [
                    {
                      "properties": {
                        "event": {
                          "enum": [
                            "default"
                          ]
                        }
                      }
                    },
                    {
                      "properties": {
                        "event": {
                          "enum": [
                            "poll"
                          ]
                        },
                        "rate_ms": {
                          "type": "integer",
                          "title": "Rate (ms)",
                          "description": "Read every N ms, e.g. 100.",
                          "default": 100,
                          "minimum": 1
                        }
                      }
                    },
                    {
                      "properties": {
                        "event": {
                          "enum": [
                            "a2l"
                          ]
                        },
                        "a2l_event": {
                          "type": "string",
                          "title": "A2L Event",
                          "description": "An event from the A2L, e.g. 10ms.",
                          "ui:widget": "action-choices",
                          "ui:options": {
                            "action": "XCP/list_a2l_events"
                          }
                        }
                      },
                      "required": [
                        "a2l_event"
                      ]
                    }
                  ]
                }
              },
              "ui:order": [
                "event",
                "rate_ms",
                "a2l_event",
                "signals"
              ]
            }
          }
        },
        "required": [
          "interface"
        ],
        "dependencies": {
          "interface": {
            "oneOf": [
              {
                "properties": {
                  "interface": {
                    "enum": [
                      "SocketCAN"
                    ]
                  },
                  "channel": {
                    "type": "string",
                    "title": "Channel",
                    "description": "SocketCAN interface name (can0, vcan0, slcan0, ...). Choose from the interfaces on the machine running the agent, or type a name.",
                    "default": "can0",
                    "ui:widget": "action-choices",
                    "ui:options": {
                      "action": "XCP/list_interfaces"
                    }
                  },
                  "fd_mode": {
                    "type": "boolean",
                    "title": "CAN-FD Mode",
                    "description": "Enable CAN-FD for higher data rates and larger payloads",
                    "default": false,
                    "ui:widget": "toggle"
                  },
                  "config_json": {
                    "type": "string",
                    "title": "Advanced Configuration (JSON)",
                    "description": "Additional python-can Bus() kwargs as JSON object"
                  },
                  "tx_id": {
                    "type": "string",
                    "title": "Command CAN ID",
                    "description": "Master to ECU, e.g. 0x7F0.",
                    "pattern": "^(0[xX])?[0-9A-Fa-f]{1,8}$",
                    "ui:placeholder": "defaults to CAN_ID_MASTER from A2L"
                  },
                  "rx_id": {
                    "type": "string",
                    "title": "Response CAN ID",
                    "description": "ECU to master (responses and DAQ), e.g. 0x7F1.",
                    "pattern": "^(0[xX])?[0-9A-Fa-f]{1,8}$",
                    "ui:placeholder": "defaults to CAN_ID_SLAVE from A2L"
                  },
                  "extended_ids": {
                    "type": "boolean",
                    "title": "Extended IDs",
                    "description": "The two CAN ids above are 29-bit extended ids. Ids taken from the A2L carry their own format.",
                    "default": false,
                    "ui:widget": "toggle"
                  }
                },
                "required": [
                  "channel"
                ],
                "dependencies": {
                  "fd_mode": {
                    "oneOf": [
                      {
                        "properties": {
                          "fd_mode": {
                            "enum": [
                              false
                            ]
                          }
                        }
                      },
                      {
                        "properties": {
                          "fd_mode": {
                            "enum": [
                              true
                            ]
                          },
                          "data_bitrate": {
                            "type": "integer",
                            "title": "CAN-FD Data Bitrate (bps)",
                            "description": "CAN-FD data phase bitrate",
                            "enum": [
                              500000,
                              1000000,
                              2000000,
                              4000000,
                              8000000
                            ],
                            "default": 2000000
                          }
                        },
                        "required": [
                          "data_bitrate"
                        ]
                      }
                    ]
                  }
                }
              },
              {
                "properties": {
                  "interface": {
                    "enum": [
                      "SocketCAN over SSH"
                    ]
                  },
                  "remote_host": {
                    "type": "string",
                    "title": "Remote Host",
                    "description": "Hostname or IP of the edge device running SocketCAN, reached over SSH (may be a ~/.ssh/config alias)"
                  },
                  "remote_channel": {
                    "type": "string",
                    "title": "Remote CAN Channel",
                    "description": "SocketCAN interface name on the remote edge device (e.g. can0, vcan0)",
                    "default": "can0"
                  },
                  "ssh_user": {
                    "type": "string",
                    "title": "SSH User",
                    "description": "Username for the SSH connection (optional; falls back to your ssh config / current user)"
                  },
                  "ssh_port": {
                    "type": "integer",
                    "title": "SSH Port",
                    "description": "TCP port for the SSH connection",
                    "default": 22
                  },
                  "ssh_key_path": {
                    "type": "string",
                    "title": "SSH Key File",
                    "description": "Path to a private key file for SSH authentication (optional)",
                    "ui:widget": "file-picker"
                  },
                  "ssh_host_key_policy": {
                    "type": "string",
                    "title": "SSH Host Key Policy",
                    "description": "How to treat the edge's SSH host key. 'auto' trusts whatever key the device presents and records nothing, so a reimaged device (which comes back with a new key) reconnects with no manual step. 'strict' uses your own ~/.ssh/known_hosts: an unknown or changed key is reported and the bus stops, rather than retrying.",
                    "enum": [
                      "auto",
                      "strict"
                    ],
                    "default": "auto"
                  },
                  "ssh_extra_opts": {
                    "type": "string",
                    "title": "SSH Extra Options",
                    "description": "Additional ssh command-line options, space-separated (e.g. -J bastion). Placed before the options above; ssh honours the first -o it sees, so these win over the settings above."
                  },
                  "ssh_hw_timestamps": {
                    "type": "boolean",
                    "title": "Hardware timestamps",
                    "description": "Uses the adapter's hardware clock when the edge's candump supports -H; interfaces without one (vcan, some slcan) fall back to the extension's wall clock. Turn off to use the edge kernel's receive time.",
                    "default": true,
                    "ui:widget": "toggle"
                  },
                  "fd_mode": {
                    "type": "boolean",
                    "title": "CAN-FD Mode",
                    "description": "Enable CAN-FD for higher data rates and larger payloads",
                    "default": false,
                    "ui:widget": "toggle"
                  },
                  "tx_id": {
                    "type": "string",
                    "title": "Command CAN ID",
                    "description": "Master to ECU, e.g. 0x7F0.",
                    "pattern": "^(0[xX])?[0-9A-Fa-f]{1,8}$",
                    "ui:placeholder": "defaults to CAN_ID_MASTER from A2L"
                  },
                  "rx_id": {
                    "type": "string",
                    "title": "Response CAN ID",
