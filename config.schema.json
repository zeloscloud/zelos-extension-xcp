                    "pattern": "^(0[xX])?[0-9A-Fa-f]{1,8}$",
                    "ui:placeholder": "defaults to CAN_ID_SLAVE from A2L"
                  },
                  "extended_ids": {
                    "type": "boolean",
                    "title": "Extended IDs",
                    "description": "The two CAN ids above are 29-bit extended ids. Ids taken from the A2L carry their own format.",
                    "default": false,
                    "ui:widget": "toggle"
                  }
                },
                "required": [
                  "remote_host"
                ]
              },
